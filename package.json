{
  "name": "knock-knock",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "pretest": "node scripts/require-java.mjs",
    "test": "firebase emulators:exec --project demo-knock-knock --only auth,firestore \"vitest run\"",
    "presmoke": "node scripts/require-java.mjs && npm run build -w functions && npx playwright install webkit chromium",
    "smoke": "firebase emulators:exec --project demo-knock-knock --only auth,firestore,functions \"playwright test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "vitest": "^5.1.2"
  }
}
