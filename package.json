{
  "name": "knock-knock",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "predev": "node scripts/require-java.mjs && npm run build -w functions",
    "dev": "concurrently -k -n emu,web \"firebase emulators:start --project demo-knock-knock\" \"NEXT_PUBLIC_FIREBASE_EMULATORS=1 npm run dev -w web\"",
    "check": "tsc --noEmit && eslint . && npm run check --workspaces --if-present",
    "pretest": "node scripts/require-java.mjs",
    "test": "firebase emulators:exec --project demo-knock-knock --only auth,firestore \"vitest run\"",
    "presmoke": "node scripts/require-java.mjs && npm run build -w functions && npx playwright install webkit chromium",
    "smoke": "firebase emulators:exec --project demo-knock-knock --only auth,firestore,functions \"playwright test\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.1.2"
  }
}
